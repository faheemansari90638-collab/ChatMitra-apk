rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profiles
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Conversations / Chats
    match /chats/{chatId} {
      allow get: if isSignedIn() && (request.auth.uid in existing().participantIds);
      allow list: if isSignedIn() && (request.auth.uid in existing().participantIds);
      allow create: if isSignedIn() && (request.auth.uid in incoming().participantIds) && isValidId(chatId);
      allow update: if isSignedIn() && (request.auth.uid in existing().participantIds);
      allow delete: if isSignedIn() && (request.auth.uid in existing().participantIds);

      // Messages subcollection
      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid && isValidId(messageId);
        allow update: if isSignedIn() && (existing().senderId == request.auth.uid || incoming().diff(existing()).affectedKeys().hasOnly(['status']));
        allow delete: if isSignedIn() && existing().senderId == request.auth.uid;
      }
    }
  }
}
